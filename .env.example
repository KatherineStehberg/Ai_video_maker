# ============================================================
# AI_Video_Maker - configuracion opcional
# NINGUNA de estas variables es obligatoria.
# El montaje funciona sin claves; configura el proveedor de voz que vayas a usar.
# Copia este archivo a .env y descomenta solo lo que uses.
# ============================================================

# --- Servidor local ---
# PORT=4321
# HOST=127.0.0.1
# RENDER_PROFILE=fast
# RENDER_THREADS=4
# NARRATION_WPM=115
# Desactiva la cola de cursos si solo necesitas editar proyectos individuales.
# COURSE_PRODUCTION_ENABLED=0

# --- FFmpeg (si NO usas el binario de npm ffmpeg-static) ---
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# --- LLM (TODO OPCIONAL). Valores: none | ollama | openai-compatible
# LLM_PROVIDER=none
# Ollama local (gratis, requiere instalar Ollama aparte)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# Cualquier API compatible OpenAI (DeepSeek, Groq, OpenRouter free tier, LM Studio...)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# --- TTS. Valores: sapi | piper | edge | elevenlabs | none
# TTS_PROVIDER=sapi
# PIPER_PATH=C:\piper\piper.exe
# PIPER_MODEL=C:\piper\voices\es_ES-sharvard-medium.onnx
# Clave privada del backend. Nunca la compartas ni la escribas en el navegador.
# ELEVENLABS_API_KEY=
# Modelo multilingüe de alta calidad con timestamps para sincronizar subtítulos.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Perfil inicial de profesor: ritmo calmado, pausas según puntuación y expresividad moderada.
# También se pueden guardar estos ajustes por proyecto desde el editor.
# ELEVENLABS_STABILITY=0.42
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0.25
# ELEVENLABS_SPEED=0.92
# ELEVENLABS_SPEAKER_BOOST=1

# --- Subtitulos. Valores: estimated | whisper
# SUBTITLE_PROVIDER=estimated
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=models/ggml-base.bin

# --- Imagenes. Valores: local | placeholder | pexels
# IMAGE_PROVIDER=local
# Pexels tiene free tier real (200 req/hora). Opcional.
# Tu clave va en .env, NUNCA aqui: .env.example se sube a Git.
# PEXELS_API_KEY=
# Análisis opcional de video: clave sólo en backend (.env ignorado por Git).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Muestreo solicitado al modelo; no es el FPS original ni garantiza todos los frames.
GEMINI_VIDEO_FPS=1

# --- Generacion de video con IA ---
# Proveedor predeterminado: pipeline (montaje local del guion, no video generativo).
# mock produce solo material sintético de prueba.
# Las ranuras 'api' y 'local' estan declaradas pero NO implementadas:
# ver src/providers/video-generation/index.js para el contrato exacto.
# VIDEO_GEN_PROVIDER=pipeline
# VIDEO_GEN_API_URL=
# VIDEO_GEN_API_KEY=
# VIDEO_GEN_LOCAL_BIN=

# Voces Edge TTS (opcional; servicio en línea, el texto sale del equipo).
# Instalar primero: python -m pip install -r requirements-voices.txt
# Ruta al Python donde instalaste edge-tts (no un comando con argumentos):
# EDGE_TTS_PYTHON=C:\ruta\a\python.exe
# Elige Edge en el selector de voz, o define TTS_PROVIDER=edge.

# Generación de clips originales con Wan (desactivada hasta configurar).
WAN_ENABLED=0
WAN_BACKEND=local
# Python del entorno donde instalaste Wan o gradio_client.
WAN_PYTHON=
# Checkout oficial de Wan2.2 y pesos Wan2.2-TI2V-5B.
WAN_REPO_DIR=
WAN_MODEL_DIR=
WAN_MAX_SCENES=8
WAN_CLIP_SECONDS=5
# Alternativa: un Space Gradio Wan que permita API (cuota y colas).
# No se garantiza un demo gratuito accesible; verifica sus condiciones.
WAN_SPACE_ID=
WAN_SPACE_API_NAME=
# JSON con nombres EXACTOS obtenidos de «Use via API» del Space.
# Placeholders: $prompt, $image, $seconds, $width, $height, $seed.
WAN_SPACE_ARGS=
# Opcional; exclusivamente en backend. No compartas esta clave.
HF_TOKEN=
