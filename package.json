{
  "name": "ai-video-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Creador de video con IA, local-first y costo cero. Ecosistema KSL.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "avm": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/cli.js",
    "doctor": "node src/cli.js doctor",
    "courses": "node scripts/course-production-check.mjs",
    "courses:check": "node scripts/course-production-check.mjs",
    "courses:test": "node scripts/ejecutar-pruebas.mjs tests/course-production.test.js tests/course-production-contract.test.js tests/course-production-http.test.js",
    "demo": "node src/cli.js demo",
    "test": "node scripts/ejecutar-pruebas.mjs"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "tts",
    "ksl",
    "local-first"
  ],
  "license": "UNLICENSED"
}
